<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DH Firebase Deployer"
        android:textColor="#00E676"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- زرار استيراد ملف مفاتيح فايربيس JSON -->
    <Button
        android:id="@+id/btnImportJson"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="1. اختيار ملف مفاتيح Firebase (.json)"
        android:textSize="14sp"
        android:backgroundTint="#37474F"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvAccountStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حالة الحساب: غير متصل"
        android:textColor="#FFAB40"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- زرار استعراض فولدر public -->
    <Button
        android:id="@+id/btnBrowse"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="2. استعراض فولدر public"
        android:textSize="15sp"
        android:backgroundTint="#263238"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvFolderPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الفولدر: لم يتم الاختيار بعد"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <!-- زرار الرفع -->
    <Button
        android:id="@+id/btnUpload"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="رفع التحديثات الآن (Deploy)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#00C853"
        android:textColor="#000000" />

    <!-- شاشة السجل -->
    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:background="#1E1E1E"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="جاهز للعمل..."
            android:textColor="#E0E0E0"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>
